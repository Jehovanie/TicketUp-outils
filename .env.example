# --- Compte administrateur MinIO (console web) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-32-chars-minimum

# --- Ports exposes sur l'hote ---
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- URLs publiques (a changer en production) ---
MINIO_SERVER_URL=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001

# --- Bucket + credentials utilises par l'application ---
APP_BUCKET=user-files
APP_ACCESS_KEY=app-access-key
APP_SECRET_KEY=change-me-too-32-chars-minimum
